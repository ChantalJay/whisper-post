NODE_ENV=development
PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Keep this secret safe and stable. Losing it makes queued messages unreadable.
APP_ENCRYPTION_KEY=

# SMTP settings from your email provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WhisperPost <no-reply@example.com>
